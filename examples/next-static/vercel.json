{
  "buildCommand": "npm run afterimage:build",
  "outputDirectory": ".afterimage/site",
  "framework": null,
  "rewrites": [
    {
      "source": "/:path((?!afterimage/|afterimage$).+)",
      "destination": "/:path*.html"
    }
  ],
  "redirects": [
    {
      "source": "/afterimage",
      "destination": "/afterimage/"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
