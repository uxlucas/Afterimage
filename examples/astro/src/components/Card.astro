---
const { title, href, label } = Astro.props;
---

<article class="card">
	<h2>{title}</h2>
	<slot />
	{href && <a href={href}>{label}</a>}
</article>

<style>
	.card {
		max-width: 32rem;
		padding: 1.5rem;
		border: 1px solid #e4e4e7;
		border-radius: 0.75rem;
	}
	h2 {
		margin-top: 0;
		font-size: 1.25rem;
	}
	a {
		color: #4f46e5;
	}
</style>
