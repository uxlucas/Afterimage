{
  "name": "afterimage-cli",
  "version": "0.1.0",
  "description": "A version history for prototypes, deployed with the prototype itself.",
  "license": "MIT",
  "keywords": [
    "version-history",
    "prototype",
    "prototyping",
    "design",
    "viewer",
    "compare",
    "diff",
    "static-site",
    "vercel",
    "netlify"
  ],
  "homepage": "https://github.com/uxlucas/Afterimage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxlucas/Afterimage.git"
  },
  "bugs": {
    "url": "https://github.com/uxlucas/Afterimage/issues"
  },
  "type": "module",
  "bin": {
    "afterimage": "bin/afterimage.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src/cli",
    "src/engine/manifest.js",
    "src/runtime",
    "viewer-dist",
    "agents",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:viewer": "node scripts/build-viewer.mjs",
    "install:examples": "node scripts/install-examples.mjs",
    "pretest:e2e": "npm run build:viewer && npm run install:examples",
    "prepack": "npm run build:viewer",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\""
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "motion": "14.9.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  }
}
